<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test"
            android:textSize="30sp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            android:textStyle="bold">
        </TextView>

        <RadioGroup
            android:id="@+id/radioGroup1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:text="@string/question1Radio"
                android:textSize="20sp"
                android:textStyle="bold|italic">
            </TextView>

            <RadioButton
                android:id="@+id/radio1"
                android:text="@string/q1a1"
                android:button="@drawable/checkbox_selector"
                style="@style/radio_button">
            </RadioButton>

            <RadioButton
                android:id="@+id/radio2"
                android:text="@string/q1a2"
                style="@style/radio_button">
            </RadioButton>

            <RadioButton
                android:id="@+id/radio3"
                android:text="@string/q1a3"
                style="@style/radio_button">
            </RadioButton>

            <RadioButton
                android:id="@+id/radio4"
                android:text="@string/q1a4"
                style="@style/radio_button">
            </RadioButton>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question2Check"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:textStyle="bold|italic">
        </TextView>

        <CheckBox
            android:id="@+id/checkbox11"
            style="@style/checkBox"
            android:text="@string/q2a1">
        </CheckBox>

        <CheckBox
            android:id="@+id/checkbox12"
            style="@style/checkBox"
            android:text="@string/q2a2">
        </CheckBox>

        <CheckBox
            android:id="@+id/checkbox13"
            style="@style/checkBox"
            android:text="@string/q2a3">
        </CheckBox>

        <CheckBox
            android:id="@+id/checkbox14"
            style="@style/checkBox"
            android:text="@string/q2a4">
        </CheckBox>

        <RadioGroup
            android:id="@+id/radioGroup2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question3Radio"
                android:textSize="20sp"
                android:textStyle="bold|italic">
            </TextView>

            <RadioButton
                android:id="@+id/radio21"
                android:text="@string/q3a1"
                style="@style/radio_button">
            </RadioButton>

            <RadioButton
                android:id="@+id/radio22"
                android:text="@string/q3a2"
                style="@style/radio_button">
            </RadioButton>

            <RadioButton
                android:id="@+id/radio23"
                android:text="@string/q3a3"
                style="@style/radio_button">
            </RadioButton>

            <RadioButton
                android:id="@+id/radio24"
                android:text="@string/q3a4"
                style="@style/radio_button">
            </RadioButton>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question4Check"
            android:textSize="20sp"
            android:textStyle="bold|italic">
        </TextView>

        <CheckBox
            android:id="@+id/checkbox21"
            style="@style/checkBox"
            android:text="@string/q4a1">
        </CheckBox>

        <CheckBox
            android:id="@+id/checkbox22"
            style="@style/checkBox"
            android:text="@string/q4a2">
        </CheckBox>

        <CheckBox
            android:id="@+id/checkbox23"
            style="@style/checkBox"
            android:text="@string/q4a3">
        </CheckBox>

        <CheckBox
            android:id="@+id/checkbox24"
            style="@style/checkBox"
            android:text="@string/q4a4">
        </CheckBox>

        <TextView
            android:layout_width="wrap_content"
            style="@style/checkBox"
            android:text="@string/question5Toggle"
            android:textSize="20sp"
            android:textStyle="bold|italic">
        </TextView>

        <ToggleButton
            android:id="@+id/toggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="@string/q5a2"
            android:textOff="@string/q5a1"
            android:checked="false">
        </ToggleButton>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:textSize="25sp"
            android:layout_height="wrap_content"
            android:textStyle="bold">
        </TextView>

        <Button
            android:id="@+id/buttonResult"
            android:layout_marginTop="10dp"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="@string/result"
            android:layout_gravity="center"
            android:background="@drawable/button_shape"
            android:textSize="15sp">
        </Button>

    </LinearLayout>
</ScrollView>
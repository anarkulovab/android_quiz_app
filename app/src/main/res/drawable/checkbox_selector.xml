<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Не выбрано -->
    <item android:drawable="@drawable/radio_unchecked"
        android:state_checked="false"
        android:width="24dp"
        android:height="24dp"/>

    <!-- Выбрано -->
    <item android:drawable="@drawable/radio_checked"
        android:state_checked="true"
        android:width="24dp"
        android:height="24dp"/>

    <!-- По умолчанию -->
    <item android:drawable="@drawable/radio_unchecked"
        android:width="24dp"
        android:height="24dp"/>
</selector>